{
  "log": {
    "disabled": false,
    "level": "info",
    "output": "",
    "timestamp": false
  },
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "external_ui": "zashboard",
      "secret": "singbox",
      "external_ui_download_url": "https://gh-proxy.com/https://github.com/Zephyruso/zashboard/archive/refs/heads/gh-pages.zip",
      "external_ui_download_detour": "🎯 全球直连",
      "default_mode": "Rule"
    },
    "cache_file": {
      "enabled": true,
      "store_fakeip": true,
      "store_dns": true
    }
  },
  "services": [
    {
      "type": "api",
      "listen": "::",
      "listen_port": 9999,
      "secret": "singbox",
      "dashboard": {
        "enabled": true,
        "path": "dashboard",
        "download_url": "https://gh-proxy.com/https://github.com/SagerNet/sing-box-dashboard/archive/refs/heads/gh-pages.zip",
        "http_client": "default",
        "update_interval": "1d"
      }
    }
  ],
  "http_clients": [
    {
      "tag": "default",
      "version": 2,
      "detour": "🚀 节点选择"
    }
  ],
  "dns": {
    "servers": [
      {
        "tag": "Fake-IP",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      },
      {
        "tag": "Local-DNS",
        "type": "https",
        "domain_resolver": "Local-DNS-Resolver",
        "server_port": 443,
        "server": "223.5.5.5",
        "path": "/dns-query"
      },
      {
        "tag": "Local-DNS-Resolver",
        "type": "udp",
        "server_port": 53,
        "server": "223.5.5.5"
      },
      {
        "tag": "Remote-DNS",
        "type": "tls",
        "detour": "🚀 节点选择",
        "domain_resolver": "Remote-DNS-Resolver",
        "server_port": 853,
        "server": "8.8.8.8"
      },
      {
        "tag": "Remote-DNS-Resolver",
        "type": "udp",
        "detour": "🚀 节点选择",
        "server_port": 53,
        "server": "8.8.8.8"
      }
    ],
    "rules": [
      {
        "clash_mode": "Direct",
        "action": "route",
        "server": "Local-DNS"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "server": "Fake-IP"
      },
      {
        "rule_set": [
          "GeoSite-Apple-CN"
        ],
        "action": "route",
        "server": "Local-DNS"
      },
      {
        "rule_set": [
          "GeoSite-CN"
        ],
        "action": "route",
        "server": "Local-DNS"
      },
      {
        "query_type": "HTTPS",
        "action": "reject"
      },
      {
        "domain_suffix": [
          "lancache.steamcontent.com",
          "10099.com.cn",
          "msftconnecttest.com",
          "msftncsi.com",
          "local",
          "lan",
          "home",
          "internal",
          "corp",
          "example.com"
        ],
        "server": "Local-DNS"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "action": "route",
        "server": "Fake-IP",
        "rewrite_ttl": 1
      }
    ],
    "optimistic": true,
    "strategy": "prefer_ipv4",
    "final": "Remote-DNS"
  },
  "inbounds": [
    {
      "tag": "mixed-in",
      "type": "mixed",
      "listen": "0.0.0.0",
      "listen_port": 7890
    },
    {
      "tag": "tun-in",
      "type": "tun",
      "address": [
        "172.19.0.0/30",
        "fdfe:dcba:9876::0/126"
      ],
      "stack": "mixed",
      "auto_route": true,
      "strict_route": true,
      "platform": {
        "http_proxy": {
          "enabled": true,
          "server": "127.0.0.1",
          "server_port": 7890
        }
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "block",
      "tag": "block"
    },
    {
      "type": "selector",
      "tag": "🚀 节点选择",
      "interrupt_exist_connections": true,
      "outbounds": [
        "🎈 自动选择"
      ]
    },
    {
      "type": "urltest",
      "tag": "🎈 自动选择",
      "url": "http://www.gstatic.com/generate_204",
      "interval": "10m",
      "tolerance": 50,
      "outbounds": []
    },
    {
      "type": "selector",
      "tag": "🤖 AI服务",
      "interrupt_exist_connections": true,
      "outbounds": [
        "🎈 自动选择",
        "🎯 全球直连"
      ]
    },
    {
      "type": "selector",
      "tag": "🎯 全球直连",
      "interrupt_exist_connections": true,
      "outbounds": [
        "direct",
        "block"
      ]
    },
    {
      "type": "selector",
      "tag": "🛑 全球拦截",
      "interrupt_exist_connections": true,
      "outbounds": [
        "block",
        "direct"
      ]
    },
    {
      "type": "selector",
      "tag": "🐟 漏网之鱼",
      "interrupt_exist_connections": true,
      "outbounds": [
        "🚀 节点选择",
        "🎯 全球直连"
      ]
    },
    {
      "type": "selector",
      "tag": "GLOBAL",
      "interrupt_exist_connections": true,
      "outbounds": [
        "🚀 节点选择",
        "🎈 自动选择",
        "🎯 全球直连",
        "🛑 全球拦截",
        "🐟 漏网之鱼"
      ]
    }
  ],
  "route": {
    "default_domain_resolver": "Local-DNS-Resolver",
    "default_http_client": "default",
    "auto_detect_interface": true,
    "find_process": true,
    "final": "🐟 漏网之鱼",
    "rules": [
      {
        "action": "sniff"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 53
          },
          {
            "protocol": "dns"
          }
        ],
        "action": "hijack-dns"
      },
      {
        "clash_mode": "Direct",
        "action": "route",
        "outbound": "🎯 全球直连"
      },
      {
        "rule_set": [
          "GeoSite-Apple-CN"
        ],
        "action": "route",
        "outbound": "🎯 全球直连"
      },
      {
        "domain_suffix": [
          "superfj.com"
        ],
        "action": "route",
        "outbound": "🤖 AI服务"
      },
      {
        "ip_cidr": [
          "207.57.123.187",
          "2001:df1:7880:6::c4"
        ],
        "action": "route",
        "outbound": "🤖 AI服务"
      },
      {
        "rule_set": [
          "GeoSite-CN"
        ],
        "action": "route",
        "outbound": "🎯 全球直连"
      },
      {
        "action": "resolve"
      },
      {
        "rule_set": [
          "GeoIP-CN"
        ],
        "action": "route",
        "outbound": "🎯 全球直连"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "🎯 全球直连"
      }
    ],
    "rule_set": [
      {
        "tag": "GeoSite-CN",
        "type": "remote",
        "url": "https://gh-proxy.com/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/cn.srs",
