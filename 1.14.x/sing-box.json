{
  "log": {
    "level": "info"
  },
  "dns": {
    "servers": [
      {
        "tag": "hosts_dns",
        "type": "hosts",
        "predefined": {
          "dns.alidns.com": [
            "223.5.5.5",
            "223.6.6.6",
            "2400:3200::1",
            "2400:3200:baba::1"
          ],
          "dns.google": [
            "8.8.8.8",
            "8.8.4.4",
            "2001:4860:4860::8888",
            "2001:4860:4860::8844"
          ]
        }
      },
      {
        "tag": "ali-udp",
        "type": "udp",
        "server": "dns.alidns.com",
        "domain_resolver": "hosts_dns"
      },
      {
        "tag": "gg-udp",
        "type": "udp",
        "detour": "🚀 节点选择",
        "server": "dns.google",
        "domain_resolver": "hosts_dns"
      },
      {
        "tag": "ali-doh",
        "type": "https",
        "server": "dns.alidns.com",
        "domain_resolver": "hosts_dns"
      },
      {
        "tag": "gg-doh",
        "type": "https",
        "server": "dns.google",
        "domain_resolver": "hosts_dns",
        "detour": "🚀 节点选择"
      },
      {
        "tag": "gg-dot",
        "type": "tls",
        "server": "dns.google",
        "domain_resolver": "hosts_dns",
        "detour": "🚀 节点选择"
      },
      {
        "tag": "FakeIP",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [
      {
        "action": "route",
        "clash_mode": "direct",
        "server": "ali-udp"
      },
      {
        "action": "route",
        "clash_mode": "global",
        "server": "gg-udp"
      },
      {
        "action": "route",
        "rule_set": [
          "GeoSite-Apple",
          "GeoSite-CN",
          "GeoSite-Geolocation-CN"
        ],
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "ali-doh"
      },
      {
        "query_type": [
          "HTTPS",
          "SVCB"
        ],
        "action": "reject"
      },
      {
        "action": "route",
        "rule_set": [
            "GeoSite-AI-!CN",
            "GeoSite-Docker",
            "GeoSite-GFW",
            "GeoSite-Geolocation-!CN"
          ],
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "gg-doh"
      }

    ],
    "optimistic": {
      "enabled": true,
      "timeout": "3d"
    },
    "final": "gg-doh",
    "strategy": "prefer_ipv4"
  },
  "ntp": {
    "enabled": true,
    "server": "time.apple.com",
    "server_port": 123,
    "interval": "30m"
  },
  "http_clients": [
    {
      "tag": "🚀 节点选择",
      "detour": "🚀 节点选择"
    }
  ],
  "inbounds": [
    {
      "tag": "tun-in",
      "type": "tun",
      "interface_name": "",
      "address": [
        "172.18.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "mtu": 1500,
      "auto_route": true,
      "strict_route": false,
      "stack": "mixed",
      "dns_mode": "hijack",
      "platform": {
        "http_proxy": {
          "enabled": true,
          "server": "127.0.0.1",
          "server_port": 7890
        }
      },
      "route_exclude_address_set": [
        "GeoIP-Private",
        "GeoIP-CN"
      ]
    },
    {
      "tag": "mixed-in",
      "type": "mixed",
      "listen": "127.0.0.1",
      "listen_port": 7890
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "🚀 节点选择",
      "interrupt_exist_connections": true,
      "outbounds": [
        "🎈 自动选择"
      ]
    },
    {
      "type": "selector",
      "tag": "🧠 AI服务",
      "interrupt_exist_connections": true,
      "outbounds": [
        "🚀 节点选择",
        "🎯 全球直连"
      ]
    },
    {
      "type": "selector",
      "tag": "🍎 苹果服务",
      "interrupt_exist_connections": true,
      "outbounds": [
        "🚀 节点选择",
        "🎯 全球直连"
      ]
    },
    {
      "type": "urltest",
      "tag": "🎈 自动选择",
      "url": "https://www.gstatic.com/generate_204",
      "interval": "10m",
      "tolerance": 50,
      "outbounds": []
    },
    {
      "type": "selector",
      "tag": "🐟 漏网之鱼",
      "interrupt_exist_connections": true,
      "outbounds": [
        "🚀 节点选择",
        "🎯 全球直连"
      ]
    },
    {
      "type": "direct",
      "tag": "🎯 全球直连"
    },
    {
      "type": "block",
      "tag": "🛑 全球拦截"
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "action": "hijack-dns",
        "protocol": "dns"
      },
      {
        "action": "route",
        "clash_mode": "direct",
        "outbound": "🎯 全球直连"
      },
      {
        "action": "route",
        "clash_mode": "global",
        "outbound": "🚀 节点选择"
      },
      {
        "action": "route",
        "network": "icmp",
        "outbound": "🎯 全球直连"
      },
      {
        "action": "route",
        "protocol": "quic",
        "outbound": "🛑 全球拦截"
      },
      {
        "action": "route",
        "rule_set": [
          "GeoSite-Ads-All"
        ],
        "outbound": "🛑 全球拦截"
      },
      {
        "action": "route",
        "rule_set": "GeoIP-Private",
        "outbound": "🎯 全球直连"
      },
      {
        "action": "route",
        "rule_set": "GeoSite-CN",
        "outbound": "🎯 全球直连"
      },
      {
        "action": "route",
        "rule_set": "GeoSite-Geolocation-CN",
        "outbound": "🎯 全球直连"
      },
      {
        "action": "route",
        "rule_set": "GeoIP-CN",
        "outbound": "🎯 全球直连"
      },
      {
        "action": "route",
        "rule_set": "GeoSite-Apple",
        "outbound": "🍎 苹果服务"
      },
      {
        "action": "route",
        "rule_set": "GeoSite-Docker",
        "outbound": "🚀 节点选择"
      },
      {
        "action": "route",
        "rule_set": "GeoSite-AI-!CN",
        "outbound": "🧠 AI服务"
      },
      {
        "action": "route",
        "rule_set": "GeoSite-GFW",
        "outbound": "🚀 节点选择"
      },
      {
        "action": "route",
        "rule_set": "GeoSite-Geolocation-!CN",
        "outbound": "🚀 节点选择"
      }
    ],
    "final": "🐟 漏网之鱼",
    "auto_detect_interface": true,
    "default_http_client": "🚀 节点选择",
    "default_domain_resolver": "ali-doh",
    "rule_set": [
