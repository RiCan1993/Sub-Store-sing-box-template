{
  "log": {
    "level": "info"
  },
  "dns": {
    "servers": [
      {
        "tag": "hosts-dns",
        "type": "hosts",
        "predefined": {
          "dns.alidns.com": [
            "223.5.5.5",
            "223.6.6.6"
          ],
          "dns.google": [
            "8.8.8.8",
            "8.8.4.4"
          ]
        }
      },
      {
        "tag": "Alibaba-DNS",
        "type": "https",
        "server": "dns.alidns.com",
        "domain_resolver": "hosts-dns"
      },
      {
        "tag": "Google-DNS",
        "type": "https",
        "server": "dns.google",
        "domain_resolver": "hosts-dns",
        "detour": "🚀 节点选择"
      }
    ],
    "rules": [
      {
        "action": "route",
        "server": "hosts-dns",
        "preferred_by": "hosts-dns"
      },
      {
        "action": "route",
        "clash_mode": "Direct",
        "server": "Alibaba-DNS"
      },
      {
        "action": "route",
        "clash_mode": "Global",
        "server": "Google-DNS"
      },
      {
        "action": "reject",
        "rule_set": [
          "geosite-category-ads-all"
        ]
      },
      {
        "action": "route",
        "rule_set": [
          "geosite-apple@cn",
          "geosite-cn",
          "geosite-geolocation-cn"
        ],
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "Alibaba-DNS"
      },
      {
        "query_type": [
          "HTTPS",
          "SVCB"
        ],
        "action": "reject"
      },
      {
        "action": "route",
        "rule_set": [
          "geosite-category-ai-!cn",
          "geosite-geolocation-!cn"
          ],
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "Google-DNS"
      }
    ],
    "optimistic": true,
    "reverse_mapping": true,
    "cache_capacity": 8192,
    
    "final": "Google-DNS",
    "strategy": "prefer_ipv4"
  },
  "ntp": {
    "enabled": true,
    "server": "time.apple.com",
    "server_port": 123,
    "interval": "30m"
  },
  "certificate": {
    "store": "chrome"
  },
  "http_clients": [
    {
      "tag": "🚀 节点选择",
      "detour": "🚀 节点选择"
    }
  ],
  "inbounds": [
    {
      "tag": "tun-in",
      "type": "tun",
      "address": [
        "172.18.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "mtu": 1500,
      "auto_route": true,
      "platform": {
        "http_proxy": {
          "enabled": true,
          "server": "127.0.0.1",
          "server_port": 7890
        }
      },
      "route_exclude_address_set": [
        "GeoIP-Private",
        "geosite-cn"
      ]
    },
    {
      "tag": "mixed-in",
      "type": "mixed",
      "listen": "127.0.0.1",
      "listen_port": 7890
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "🚀 节点选择",
      "interrupt_exist_connections": true,
      "outbounds": [
        "🎈 自动选择"
      ]
    },
    {
      "type": "selector",
      "tag": "🧠 AI服务",
      "interrupt_exist_connections": true,
      "outbounds": [
        "🚀 节点选择"
      ]
    },
    {
      "type": "urltest",
      "tag": "🎈 自动选择",
      "url": "https://www.gstatic.com/generate_204",
      "interval": "10m",
      "tolerance": 50,
      "outbounds": []
    },
    {
      "type": "selector",
      "tag": "🐟 漏网之鱼",
      "interrupt_exist_connections": true,
      "outbounds": [
        "🚀 节点选择",
        "🎯 全球直连"
      ]
    },
    {
      "type": "direct",
      "tag": "🎯 全球直连"
    },
    {
      "type": "block",
      "tag": "🛑 全球拦截"
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "action": "hijack-dns",
        "protocol": "dns"
      },
      {
        "action": "route",
        "clash_mode": "Direct",
        "outbound": "🎯 全球直连"
      },
      {
        "action": "route",
        "clash_mode": "Global",
        "outbound": "🚀 节点选择"
      },
      {
        "action": "route",
        "network": "icmp",
        "outbound": "🎯 全球直连"
      },
      {
        "action": "route",
        "protocol": "quic",
        "outbound": "🛑 全球拦截"
      },
      {
        "action": "route",
        "rule_set": [
          "geosite-category-ads-all"
        ],
        "outbound": "🛑 全球拦截"
      },
      {
        "action": "route",
        "rule_set": "GeoIP-Private",
        "outbound": "🎯 全球直连"
      },
      {
        "action": "route",
        "rule_set": "geosite-apple@cn",
        "outbound": "🎯 全球直连"
      },
      {
        "action": "route",
        "rule_set": "geosite-cn",
        "outbound": "🎯 全球直连"
      },
      {
        "action": "route",
        "rule_set": "geosite-geolocation-cn",
        "outbound": "🎯 全球直连"
      },
      {
        "action": "route",
        "rule_set": "geosite-category-ai-!cn",
        "outbound": "🧠 AI服务"
      },
      {
        "action": "route",
        "rule_set": "geosite-geolocation-!cn",
        "outbound": "🚀 节点选择"
      },
      {
        "action": "resolve"
      },
      {
        "action": "route",
        "rule_set": "geoip-cn",
        "outbound": "🎯 全球直连"
      }
    ],
    "final": "🐟 漏网之鱼",
    "auto_detect_interface": true,
    "default_http_client": "🚀 节点选择",
    "default_domain_resolver": "Alibaba-DNS",
    "rule_set": [
      {
        "tag": [
          "geosite-category-ads-all",
          "geosite-apple@cn",
          "geosite-cn",
          "geosite-geolocation-cn",
          "geosite-category-ai-!cn",
          "geosite-geolocation-!cn"
        ],
        "type": "remote",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/{tag}.srs",
        "format": "binary",
        "http_client": "🚀 节点选择",
        "update_interval": "1d"
      },
      {
        "tag": "geoip-cn",
        "type": "remote",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/{tag}.srs",
        "format": "binary",
        "http_client": "🚀 节点选择",
        "update_interval": "1d"
      },
      {
        "tag": "GeoIP-Private",
        "type": "remote",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geoip/private.srs",
        "format": "binary",
        "http_client": "🚀 节点选择",
        "update_interval": "1d"
      }
    ]
  },
  "services": [
    {
      "type": "api",
      "listen": "::",
      "listen_port": 9090,
      "secret": "singbox",
      "dashboard": {
        "enabled": true,
        "path": "dashboard",
        "download_url": "https://github.com/SagerNet/sing-box-dashboard/archive/refs/heads/gh-pages.zip",
        "http_client": "🚀 节点选择",
        "update_interval": "1d"
      }
    }
  ],
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "cache.db",
      "store_dns": true
    }
  }
}
