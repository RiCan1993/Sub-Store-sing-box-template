{
  "log": {
    "level": "info"
  },
  "dns": {
    "servers": [
      {
        "tag": "Alibab-DNS",
        "type": "udp",
        "server": "223.5.5.5",
        "server_port": 53,
        "detour": "🎯 全球直连"
      },
      {
        "tag": "Google-DoH",
        "type": "https",
        "server": "dns.google",
        "server_port": 443,
        "path": "/dns-query",
        "tls": {
          "enabled": true,
          "server_name": "dns.google"
        },
        "domain_resolver": "Alibab-DNS",
        "detour": "🚀 节点选择"
      },
      {
        "tag": "FakeIP",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [
      {
        "rule_set":[
          "GeoSite-Ads-All"
        ],
        "action": "reject"
      },
      {
        "rule_set": [
          "GeoSite-Apple-CN",
          "GeoSite-CN",
          "GeoSite-Geolocation-CN"
        ],
        "action": "route",
        "server": "Alibab-DNS"
      },
      {
        "query_type": [
          "HTTPS",
          "SVCB"
        ],
        "action": "reject"
      },
      {
        "rule_set": [
          "GeoSite-AI-!CN",
          "GeoSite-Apple",
          "GeoSite-GFW",
          "GeoSite-Geolocation-!CN"
        ],
        "action": "route",
        "server": "FakeIP"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "action": "route",
        "server": "FakeIP"
      }
    ],
    "optimistic": true,
    "final": "Alibab-DNS",
    "strategy": "prefer_ipv4"
  },
  "http_clients": [
    {
      "tag": "default",
      "detour": "🚀 节点选择"
    }
  ],
  "inbounds": [
    {
      "tag": "mixed-in",
      "type": "mixed",
      "listen": "127.0.0.1",
      "listen_port": 5555
    },
    {
      "tag": "tun-in",
      "type": "tun",
      "interface_name": "sing-box",
      "address": [
        "172.18.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "mtu": 1500,
      "auto_route": true,
      "strict_route": false,
      "platform": {
        "http_proxy": {
          "enabled": true,
          "server": "127.0.0.1",
          "server_port": 5555
        }
      },
      "route_exclude_address_set": [
        "GeoIP-Private",
        "GeoIP-CN"
      ]
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "block",
      "tag": "block"
    },
    {
      "type": "selector",
      "tag": "🚀 节点选择",
      "interrupt_exist_connections": true,
      "outbounds": [
        "🎈 自动选择"
      ]
    },
    {
      "type": "selector",
      "tag": "🧠 AI服务",
      "interrupt_exist_connections": true,
      "outbounds": [
        "🚀 节点选择"
      ]
    },
    {
      "type": "selector",
      "tag": "🍎 苹果服务",
      "interrupt_exist_connections": true,
      "outbounds": [
        "🚀 节点选择"
      ]
    },
    {
      "type": "urltest",
      "tag": "🎈 自动选择",
      "url": "http://www.gstatic.com/generate_204",
      "interval": "10m",
      "tolerance": 50,
      "outbounds": []
    },
    {
      "type": "selector",
      "tag": "🎯 全球直连",
      "interrupt_exist_connections": true,
      "outbounds": [
        "direct"
      ]
    },
    {
      "type": "selector",
      "tag": "🛑 全球拦截",
      "interrupt_exist_connections": true,
      "outbounds": [
        "block"
      ]
    },
    {
      "type": "selector",
      "tag": "🐟 漏网之鱼",
      "interrupt_exist_connections": true,
      "outbounds": [
        "🚀 节点选择",
        "🎯 全球直连"
      ]
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      }, 
      {
        "action": "hijack-dns",
        "protocol": "dns"
      },
      {
        "rule_set": "GeoIP-Private",
        "action": "route",
        "outbound": "🎯 全球直连"
      },
      {
        "action": "route",
        "network": "icmp",
        "outbound": "🎯 全球直连"
      },
      {
        "rule_set": [
          "GeoSite-Ads-All"
        ],
        "action": "route",
        "outbound": "🛑 全球拦截"
      },
      {
        "rule_set": "GeoSite-Apple-CN",
        "action": "route",
        "outbound": "🎯 全球直连"
      },
      {
        "rule_set": "GeoSite-CN",
        "action": "route",
        "outbound": "🎯 全球直连"
      },
      {
        "rule_set": "GeoSite-Geolocation-CN",
        "action": "route",
        "outbound": "🎯 全球直连"
      },
      {
        "rule_set": "GeoSite-Apple",
        "action": "route",
        "outbound": "🍎 苹果服务"
      },
      {
        "rule_set": "GeoSite-AI-!CN",
        "action": "route",
        "outbound": "🧠 AI服务"
      },
      {
        "rule_set": "GeoSite-GFW",
        "action": "route",
        "outbound": "🚀 节点选择"
      },
      {
        "rule_set": "GeoSite-Geolocation-!CN",
        "action": "route",
        "outbound": "🚀 节点选择"
      },
      {
        "action": "resolve"
      },
      {
        "rule_set": "GeoIP-CN",
        "action": "route",
        "outbound": "🎯 全球直连"
      }
    ],
    "final": "🐟 漏网之鱼",
    "auto_detect_interface": true,
    "default_http_client": "default",
    "default_domain_resolver": "Alibab-DNS",
    "rule_set": [
      {
        "tag": "GeoSite-Ads-All",
        "type": "remote",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/category-ads-all.srs",
        "format": "binary",
        "http_client": "default",
        "update_interval": "1d"
      },
      {
        "tag": "GeoSite-CN",
        "type": "remote",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/cn.srs",
        "format": "binary",
        "http_client": "default",
        "update_interval": "1d"
      },
      {
        "tag": "GeoSite-Apple-CN",
        "type": "remote",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/apple-cn.srs",
        "format": "binary",
        "http_client": "default",
        "update_interval": "1d"
      },
      {
        "tag": "GeoSite-Apple",
        "type": "remote",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/apple.srs",
        "format": "binary",
        "http_client": "default",
        "update_interval": "1d"
      },
      {
        "tag": "GeoIP-CN",
        "type": "remote",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geoip/cn.srs",
        "format": "binary",
        "http_client": "default",
        "update_interval": "1d"
      },
      {
        "tag": "GeoIP-Private",
        "type": "remote",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geoip/private.srs",
        "format": "binary",
        "http_client": "default",
        "update_interval": "1d"
      },
      {
        "tag": "GeoSite-GFW",
        "type": "remote",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/gfw.srs",
        "format": "binary",
        "http_client": "default",
        "update_interval": "1d"
      },
      {
        "tag": "GeoSite-AI-!CN",
        "type": "remote",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/category-ai-!cn.srs",
        "format": "binary",
        "http_client": "default",
        "update_interval": "1d"
      },
      {
        "tag": "GeoSite-Geolocation-CN",
        "type": "remote",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/geolocation-cn.srs",
        "format": "binary",
        "http_client": "default",
        "update_interval": "1d"
      },
      {
        "tag": "GeoSite-Geolocation-!CN",
        "type": "remote",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/geolocation-!cn.srs",
        "format": "binary",
        "http_client": "default",
        "update_interval": "1d"
      }
    ]
  },
  "services": [
    {
      "type": "api",
      "listen": "::",
      "listen_port": 9090,
      "secret": "singbox",
      "dashboard": {
        "enabled": true,
        "path": "dashboard",
        "download_url": "https://github.com/SagerNet/sing-box-dashboard/archive/refs/heads/gh-pages.zip",
        "http_client": "default",
        "update_interval": "1d"
      }
    }
  ],
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "cache.db",
      "store_dns": true,
      "store_fakeip": true
    }
  }
}